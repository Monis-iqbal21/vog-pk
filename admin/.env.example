# Server-only settings. Never prefix these with NEXT_PUBLIC_.
ADMIN_ENVIRONMENT=local
ADMIN_ORIGIN=http://localhost:3001
STOREFRONT_ORIGIN=http://localhost:3000
API_URL=http://127.0.0.1:4000
BFF_SHARED_SECRET=
# false is permitted only for local loopback HTTP. Set true with HTTPS in production.
COOKIE_SECURE=false
# Enable only behind a proxy that replaces incoming forwarded headers (e.g. Vercel).
TRUST_PROXY_HEADERS=0
