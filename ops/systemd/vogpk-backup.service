[Unit]
Description=Encrypted Neon PostgreSQL backup to approved remote storage
After=network-online.target
Wants=network-online.target
OnFailure=vogpk-alert.service

[Service]
Type=oneshot
User=vogpk-backup
Group=vogpk-backup
EnvironmentFile=/etc/vogpk/backup.env
Environment=RESTIC_CACHE_DIR=/var/cache/vogpk-backup
ExecStart=/bin/bash /opt/vogpk/ops/postgres-backup.sh
StateDirectory=vogpk-backup
CacheDirectory=vogpk-backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStartSec=20min
