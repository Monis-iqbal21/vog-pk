[Unit]
Description=VOGPK API and database health checks
After=network-online.target
Wants=network-online.target
OnFailure=vogpk-alert.service

[Service]
Type=oneshot
User=ubuntu
ExecStart=/bin/bash /opt/vogpk/ops/monitor-health.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStartSec=45
