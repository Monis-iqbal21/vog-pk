# Template only. Install privately as /etc/vogpk/backup.env after destination approval.
# This file must never contain production values in Git.
BACKUP_DESTINATION_APPROVED=no
BACKUP_REPOSITORY_DEDICATED=no
BACKUP_WEEKLY_PRUNE_APPROVED=no
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/vogpk/backup/restic-password
PGSERVICEFILE=/etc/vogpk/backup/pg_service.conf
PGPASSFILE=/etc/vogpk/backup/pgpass
# For an approved OCI S3-compatible bucket only:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-mumbai-1
