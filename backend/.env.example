# Copy to .env.local; never commit actual values. Use a dedicated PostgreSQL database.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/vog_admin_dev
ADMIN_ORIGIN=http://localhost:3001
STOREFRONT_ORIGIN=http://localhost:3000
PORT=4000
# Optional. Production defaults to loopback; local development defaults to all interfaces.
# HOST=127.0.0.1
# Generate with: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
# Must match the admin's server-only BFF_SHARED_SECRET.
BFF_SHARED_SECRET=
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
# Local database helper only, not used for production:
LOCAL_POSTGRES_PASSWORD=
